# ── LibrePay Node configuration ────────────────────────────────────────────
# Copy to .env and fill. Generated values come from `bun run setup`.

# Public base URL of this node (no trailing slash). Behind Tor only? Leave
# unset and checkout URLs fall back to the request host.
# LP_BASE_URL=https://pay.example.com
# Tor mirror (docs/DEPLOY_TOR.md): clearnet responses advertise it via
# Onion-Location so Tor Browser offers to switch.
# LP_ONION_URL=http://your56charonionaddressxxxxxxxxxxxxxxxxxxxxxx.onion

# Store identity shown on checkout
LP_STORE_NAME=My Store
LP_BRAND_COLOR=#f7931a

# ── Network ───────────────────────────────────────────────────────────────
# "mainnet" (default) or "testnet" (= Bitcoin testnet4). Flips address HRP
# (bc1… ↔ tb1…), watch-only key flavor (zpub ↔ vpub), the BIP84 coin type
# and the default Esplora endpoint (mempool.space/testnet4/api) TOGETHER.
# Demo & development only — see docs/TESTNET.md before flipping this.
# LP_NETWORK=mainnet

# ── Wallet — choose ONE (the node can NEVER spend either way) ──────────────
# BIP47 payment code (PM8T…) → per-invoice stealth addresses (max privacy)
# LP_PAYMENT_CODE=
# …or zpub (BIP84) / xpub → deterministic watch-only addresses
# LP_ZPUB=

# Chain security
LP_CONFIRMATIONS_REQUIRED=2
LP_INVOICE_EXPIRY_MINUTES=15

# ── API access (REQUIRED — run `bun run setup` to generate) ────────────────
LP_API_KEY=
# Secret used for HKDF key derivation (REQUIRED in production)
LP_APP_SECRET=

# ── Webhooks ────────────────────────────────────────────────────────────────
# Comma-separated https URLs; secrets pair 1:1 (or one secret for all)
# LP_WEBHOOK_URLS=https://myshop.example.com/api/webhooks/librepay
# LP_WEBHOOK_SECRETS=
# Local integration tests only: allow loopback http:// webhook endpoints.
# NEVER enable on a public server. Default: false.
# LP_ALLOW_LOOPBACK_WEBHOOKS=false

# ── Chain outage alarm (self-monitoring, v0.8.0) ────────────────────────────
# One signed JSON POST when the Esplora provider falls / recovers / its tip
# stalls: system.esplora_down (critical) · system.esplora_up · system.esplora_stalled.
# Same HMAC contract as merchant webhooks (examples/ receivers verify it).
# Works with any JSON-accepting HTTPS endpoint (ntfy topic, Slack bot API,
# Apprise bridge, your own worker). Unset = alarms still hit the audit log
# and /api/metrics.
# LP_ALARM_WEBHOOK_URL=
# Signature secret (falls back to the first LP_WEBHOOK_SECRETS entry)
# LP_ALARM_WEBHOOK_SECRET=
# Consecutive chain-API failures before "down" (default 3)
# LP_ESPLORA_FAIL_THRESHOLD=3
# Minutes without a tip advance before the stall alarm (default 90; raise on
# testnet where blocks can legitimately pause)
# LP_TIP_STALL_MINUTES=90

# ── Lightning via phoenixd on the same box (optional) ──────────────────────
# LP_LIGHTNING_URL=http://127.0.0.1:9740
# LP_LIGHTNING_PASSWORD=

# ── Infra ───────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/node.db
# Chain data (Esplora-compatible). Default is the public mempool.space for
# convenience — but for FULL independence run your own Esplora/mempool
# instance and point this at it. The node's checkout explorer links and the
# primary price feed are both derived from this single setting.
ESPLORA_API=https://mempool.space/api
# Embedded scheduler period in ms (0 = disable, use /api/cron/tick instead)
LP_CRON_INTERVAL_MS=30000
# Guard for the manual tick endpoint
# LP_CRON_SECRET=

# ⚠️ TEST ONLY: allows POST /api/dev/simulate-payment to settle invoices
# without real on-chain payment. NEVER enable on a node holding real money.
# LP_SIMULATE=false
