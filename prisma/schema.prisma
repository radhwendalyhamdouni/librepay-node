// LibrePay Node — single-operator schema.
// Two tables. No accounts, no merchants, no plans, no refunds ledger.
// Money state lives on the chain, not in this database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Invoice {
  id String @id @default(cuid())
  // kept for contract-compatibility with the platform engine; always "self"
  merchantId String @default("self")

  // Money
  amountSats      BigInt
  receivedSats    BigInt  @default(0)
  fiatCurrency    String? // USD, EUR, ...
  fiatAmountCents Int?
  satsPerUnit     String? // exchange rate snapshot at creation (stringified float)

  // Derivation (public data only)
  derivationMode      String  @default("stealth") // stealth | watchonly
  stealthAddress      String  @unique
  ephemeralPub        String? // hex — needed by operator wallet to compute spend key
  paymentCodeSnapshot String? // payment code at creation time
  derivationIndex     Int? // for watchonly mode (m/0/{index})

  // Business fields
  orderId     String?
  description String?
  metadata    String? // stringified JSON (portable)
  buyerLang   String  @default("en")
  // API idempotency: same Idempotency-Key + merchant → the SAME invoice is
  // returned (client-safe retries on flaky networks). Unique index below —
  // SQLite treats NULLs as distinct so non-keyed invoices never conflict.
  idempotencyKey String?

  // Lifecycle: waiting → detected → confirmed → settled | expired | underpaid
  status                String    @default("waiting")
  txid                  String?
  confirmations         Int       @default(0)
  confirmationsRequired Int       @default(2)
  expiresAt             DateTime
  paidAt                DateTime?
  settledAt             DateTime?
  expiredNotified       Boolean   @default(false)
  underpaidNotified     Boolean   @default(false)
  // Reorg guard: number of consecutive cron ticks that saw the payment at
  // >= confirmationsRequired. `confirmed` fires only on the 2nd sighting —
  // one tick later (~30s) — so an Esplora hiccup or a shallow reorg can
  // never flip an invoice to confirmed prematurely.
  confirmedStreak       Int       @default(0)

  // Lightning (optional second rail — same invoice, instant settlement)
  lightningPaymentRequest String? // bolt11 invoice string (lnbc…)
  lightningPaymentHash    String? // payment hash for lookup/idempotency
  lightningPaidAt         DateTime?
  paidVia                 String? // onchain | lightning (set at first payment rail)

  webhookDeliveries WebhookDelivery[]

  // Manual refunds are sent straight from the operator wallet; we only
  // remember the first funding input for convenience.
  payerAddress String?
  refundStatus String @default("none")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lightningPaymentHash])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([status, expiresAt])
  // UNIQUE dedupe: two concurrent creates with the same key cannot both win —
  // the loser hits the constraint and returns the winner's invoice.
  // SQLite allows multiple NULLs, so keyless invoices never conflict.
  @@unique([merchantId, idempotencyKey])
}

model WebhookDelivery {
  id        String   @id @default(cuid())
  // url + secret are SNAPSHOTTED at enqueue time: editing .env later cannot
  // orphan or redirect in-flight deliveries.
  url       String
  secret    String
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  event     String
  payload   String // stringified JSON
  status    String   @default("pending") // pending | success | failed | dead
  attempts  Int      @default(0)
  responseStatus Int?
  lastError String?
  nextRetryAt DateTime?
  createdAt DateTime @default(now())

  @@index([status, nextRetryAt])
  @@index([invoiceId])
}

// Operator console sessions — the HTTP-only cookie identity ("the best way in",
// BTCPay-style: human credential ≠ API credential). Only sha256 hashes of the
// session tokens are stored; the raw token exists solely inside the cookie.
model ConsoleSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  method     String    @default("password") // password | link | firstrun
  ip         String    @default("-")
  userAgent  String    @default("")
  trusted    Boolean   @default(false) // false = 8h sliding · true = 30d sliding
  stepUpAt   DateTime? // last password re-confirmation (sensitive-action gate)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([expiresAt])
}

// One-time recovery links minted by `bun run console:link` — server access is
// the proof of ownership when the password is lost or a new device arrives.
model ConsoleLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  usedIp    String    @default("-")

  @@index([expiresAt])
}

// Operator security monitor — the console's live "who knocked on my door".
// Records auth failures (key guessing), SSRF blocks, sensitive actions and
// delivery deaths. No secrets, no payloads — IP + type + short detail only.
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String // auth_failed | auth_ok | rate_limited | ssrf_blocked | key_rotated | secrets_encrypted | webhooks_updated | backup_created | backup_restored | lightning_updated | setup_completed | delivery_dead
  severity  String   @default("info") // info | warn | critical
  ip        String   @default("-")
  userAgent String   @default("")
  detail    String   @default("")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}
